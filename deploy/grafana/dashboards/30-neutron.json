  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Neutron Sync Age",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "cubecos-prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "targets": [
        { "refId": "A", "expr": "cubecos_neutron_sync_age_seconds", "instant": true, "datasource": { "type": "prometheus", "uid": "cubecos-prometheus" } }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [
            { "type": "value", "options": { "-1": { "text": "never synced", "index": 0 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 300 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "mac_tenant_map fill",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "cubecos-prometheus" },
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "cubecos_bpf_map_current_entries{map=\"mac_tenant_map\"} / cubecos_bpf_map_max_entries{map=\"mac_tenant_map\"}",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "cubecos-prometheus" }
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "subnet_zone_trie fill",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "cubecos-prometheus" },
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "cubecos_bpf_map_current_entries{map=\"subnet_zone_trie\"} / cubecos_bpf_map_max_entries{map=\"subnet_zone_trie\"}",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "cubecos-prometheus" }
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Neutron API errors (rate over 5m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "cubecos-prometheus" },
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint, code) (rate(cubecos_neutron_api_errors_total[5m]))",
          "legendFormat": "{{endpoint}} {{code}}",
          "datasource": { "type": "prometheus", "uid": "cubecos-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": true },
          "unit": "ops"
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 5,
      "title": "BPF map entries (current vs max)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "cubecos-prometheus" },
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "cubecos_bpf_map_current_entries",
          "legendFormat": "{{map}} current",
          "datasource": { "type": "prometheus", "uid": "cubecos-prometheus" }
        },
        {
          "refId": "B",
          "expr": "cubecos_bpf_map_max_entries",
          "legendFormat": "{{map}} max",
          "datasource": { "type": "prometheus", "uid": "cubecos-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": true },
          "unit": "short"
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 6,
      "title": "Unknown device_owner admissions",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "cubecos-prometheus" },
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "cubecos_neutron_unknown_device_owner_total",
          "instant": true,
          "format": "table",
          "datasource": { "type": "prometheus", "uid": "cubecos-prometheus" }
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "job": true, "instance": true, "__name__": true } } }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } }
      },
      "options": { "showHeader": true }
    }
  ],
  "refresh": "10s",

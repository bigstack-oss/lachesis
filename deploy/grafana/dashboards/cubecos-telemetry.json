{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 100,
      "title": "Overview",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 1,
      "title": "Agent Up",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "targets": [
        { "refId": "A", "expr": "up{job=\"cubecos-agent\"}", "instant": true, "datasource": { "type": "prometheus", "uid": "${datasource}" } }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "index": 0 }, "1": { "text": "UP", "index": 1 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Tracked Flows",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "targets": [
        { "refId": "A", "expr": "cubecos_state_flows", "instant": true, "datasource": { "type": "prometheus", "uid": "${datasource}" } }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50000 },
              { "color": "red", "value": 65000 }
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 3,
      "title": "Attached Interfaces",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "targets": [
        { "refId": "A", "expr": "cubecos_attached_interfaces", "instant": true, "datasource": { "type": "prometheus", "uid": "${datasource}" } }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 4,
      "title": "Neutron Sync Age",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "targets": [
        { "refId": "A", "expr": "cubecos_neutron_sync_age_seconds", "instant": true, "datasource": { "type": "prometheus", "uid": "${datasource}" } }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [
            { "type": "value", "options": { "-1": { "text": "never synced", "index": 0 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 300 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Last Scrape Age",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "targets": [
        { "refId": "A", "expr": "time() - cubecos_scraper_last_success_unix_seconds", "instant": true, "datasource": { "type": "prometheus", "uid": "${datasource}" } }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 120 }
            ]
          },
          "unit": "s"
        }
      }
    },
    {
      "id": 6,
      "title": "telemetry_map fill",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "cubecos_bpf_map_current_entries{map=\"telemetry_map\"} / cubecos_bpf_map_max_entries{map=\"telemetry_map\"}",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.8 }
            ]
          }
        }
      }
    },
    {
      "id": 101,
      "title": "Throughput (billing)",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 10,
      "title": "Bytes/sec by direction",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (rate(cubecos_bytes_total[1m]))",
          "legendFormat": "{{direction}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "spanNulls": true },
          "unit": "binBps"
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull", "max"] } }
    },
    {
      "id": 11,
      "title": "Packets/sec by direction",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (rate(cubecos_packets_total[1m]))",
          "legendFormat": "{{direction}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "spanNulls": true },
          "unit": "pps"
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull", "max"] } }
    },
    {
      "id": 12,
      "title": "Bytes/sec by zone",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 14, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (zone) (rate(cubecos_bytes_total[1m]))",
          "legendFormat": "{{zone}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "stacking": { "mode": "normal" }, "spanNulls": true },
          "unit": "binBps"
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] } }
    },
    {
      "id": 13,
      "title": "Top tenants by bytes (1m rate)",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 8, "y": 14, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (tenant_id) (rate(cubecos_bytes_total[1m])))",
          "legendFormat": "{{tenant_id}}",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "binBps"
        }
      }
    },
    {
      "id": 14,
      "title": "Cumulative bytes by (zone, direction)",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 16, "y": 14, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (zone, direction) (cubecos_bytes_total)",
          "format": "table",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true },
            "renameByName": { "Value": "bytes" }
          }
        },
        {
          "id": "sortBy",
          "options": { "fields": {}, "sort": [{ "field": "bytes", "desc": true }] }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "left", "displayMode": "auto" },
          "unit": "bytes"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "bytes" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } }] }
        ]
      },
      "options": { "showHeader": true, "footer": { "show": false } }
    },
    {
      "id": 102,
      "title": "BPF Maps",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 20,
      "title": "Map fill ratio",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 23, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "cubecos_bpf_map_current_entries / cubecos_bpf_map_max_entries",
          "legendFormat": "{{map}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": true, "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.8 }
            ]
          },
          "unit": "percentunit",
          "max": 1,
          "min": 0
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull"] } }
    },
    {
      "id": 21,
      "title": "Map entries (current vs max)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 12, "y": 23, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "cubecos_bpf_map_current_entries",
          "legendFormat": "{{map}} current",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "refId": "B",
          "expr": "cubecos_bpf_map_max_entries",
          "legendFormat": "{{map}} max",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": true },
          "unit": "short"
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 103,
      "title": "Scraper & Collector",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 31, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 30,
      "title": "Scrape errors",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 32, "w": 8, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "rate(cubecos_scraper_errors_total[5m])", "legendFormat": "errors/s", "datasource": { "type": "prometheus", "uid": "${datasource}" } }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": true },
          "unit": "ops"
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 31,
      "title": "Time since last successful scrape",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 8, "y": 32, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - cubecos_scraper_last_success_unix_seconds",
          "legendFormat": "lag",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "thresholdsStyle": { "mode": "area" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 120 }
            ]
          },
          "unit": "s"
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false } }
    },
    {
      "id": 32,
      "title": "Collect pass duration (p50 / p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 16, "y": 32, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, rate(cubecos_collect_duration_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, rate(cubecos_collect_duration_seconds_bucket[5m]))",
          "legendFormat": "p99",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": true },
          "unit": "s"
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 104,
      "title": "Neutron",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 40, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 40,
      "title": "Neutron API errors (rate over 5m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 41, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint, code) (rate(cubecos_neutron_api_errors_total[5m]))",
          "legendFormat": "{{endpoint}} {{code}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": true },
          "unit": "ops"
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 41,
      "title": "BuildTrie avg step duration",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 12, "y": 41, "w": 6, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "cubecos_neutron_builder_step_duration_seconds_sum / cubecos_neutron_builder_step_duration_seconds_count",
          "legendFormat": "{{step}}",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "s"
        }
      }
    },
    {
      "id": 42,
      "title": "Unknown device_owner admissions",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 18, "y": 41, "w": 6, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "cubecos_neutron_unknown_device_owner_total",
          "instant": true,
          "format": "table",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "job": true, "instance": true, "__name__": true } } }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } }
      },
      "options": { "showHeader": true }
    },
    {
      "id": 105,
      "title": "WAL",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 49, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 50,
      "title": "WAL phase latency (p99 over 5m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 50, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, rate(cubecos_wal_snapshot_copy_seconds_bucket[5m]))",
          "legendFormat": "copy (lock held)",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, rate(cubecos_wal_marshal_seconds_bucket[5m]))",
          "legendFormat": "marshal",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, rate(cubecos_wal_flush_latency_seconds_bucket[5m]))",
          "legendFormat": "write+fsync+rename",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": true, "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.05 }
            ]
          },
          "unit": "s"
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] } }
    },
    {
      "id": 51,
      "title": "WAL flush failures / load fallbacks",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 12, "y": 50, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (increase(cubecos_wal_flush_failures_total[5m]))",
          "legendFormat": "flush fail: {{stage}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "refId": "B",
          "expr": "sum by (from) (increase(cubecos_wal_load_fallback_total[5m]))",
          "legendFormat": "load fallback: {{from}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },

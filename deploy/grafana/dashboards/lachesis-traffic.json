{
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "expr": "changes(lachesis_agent_counters_reset_timestamp_seconds[1m]) > 0",
        "iconColor": "red",
        "name": "Counters reset",
        "titleFormat": "Billing state restarted",
        "textFormat": "The agent on {{instance}} declared a counters-reset epoch \u2014 series baselines are not comparable across this instant (docs/architecture/boot-and-recovery.md).",
        "useValueForTime": false
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "CubeCOS \u00b7 Network Telemetry",
      "type": "dashboards",
      "tags": [
        "lachesis"
      ],
      "asDropdown": true,
      "includeVars": true
    }
  ],
  "liveNow": false,
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "lachesis",
    "traffic"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "options": []
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(up{job=\"lachesis-agent\"}, instance)",
          "refId": "node"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "options": []
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "query_result(lachesis_tenant_info)",
          "refId": "tenant"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "options": [],
        "regex": "/name=\"(?<text>[^\"]+)\".*tenant_id=\"(?<value>[^\"]+)\"/"
      },
      {
        "name": "zone",
        "label": "Zone",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(lachesis_tenant_bytes_total, zone)",
          "refId": "zone"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "options": []
      },
      {
        "name": "external_network",
        "label": "External network",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(lachesis_tenant_bytes_total, external_network)",
          "refId": "external_network"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "options": []
      },
      {
        "name": "server",
        "label": "Server",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "query_result(lachesis_server_info)",
          "refId": "server"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "options": [],
        "regex": "/name=\"(?<text>[^\"]+)\".*server_id=\"(?<value>[^\"]+)\"/"
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "title": "CubeCOS \u00b7 Traffic",
  "uid": "lachesis-traffic",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Tenant traffic",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Bytes/sec by tenant \u2014 tx (VM sending)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Upload rate per tenant \u2014 bytes the tenant's VMs are sending, summed across all selected nodes. Use the Tenant/Zone/External network filters to narrow; a sudden spike identifies which tenant is pushing traffic.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant_id) (rate(lachesis_tenant_bytes_total{instance=~\"$node\",tenant_id=~\"$tenant\",zone=~\"$zone\",external_network=~\"$external_network\",direction=\"tx\"}[1m])) * on(tenant_id) group_left(name) max by (tenant_id, name) (lachesis_tenant_info)",
          "legendFormat": "{{name}} ({{tenant_id}})",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (tenant_id) (rate(lachesis_tenant_bytes_total{instance=~\"$node\",tenant_id=~\"$tenant\",zone=~\"$zone\",external_network=~\"$external_network\",direction=\"tx\"}[1m])) unless on(tenant_id) lachesis_tenant_info",
          "legendFormat": "{{tenant_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": true
          },
          "unit": "binBps"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "title": "Bytes/sec by tenant \u2014 rx (VM receiving)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Download rate per tenant \u2014 bytes the tenant's VMs are receiving, summed across all selected nodes.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant_id) (rate(lachesis_tenant_bytes_total{instance=~\"$node\",tenant_id=~\"$tenant\",zone=~\"$zone\",external_network=~\"$external_network\",direction=\"rx\"}[1m])) * on(tenant_id) group_left(name) max by (tenant_id, name) (lachesis_tenant_info)",
          "legendFormat": "{{name}} ({{tenant_id}})",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (tenant_id) (rate(lachesis_tenant_bytes_total{instance=~\"$node\",tenant_id=~\"$tenant\",zone=~\"$zone\",external_network=~\"$external_network\",direction=\"rx\"}[1m])) unless on(tenant_id) lachesis_tenant_info",
          "legendFormat": "{{tenant_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": true
          },
          "unit": "binBps"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "title": "Cumulative bytes by tenant (billable view)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Lifetime byte totals per (tenant, zone, direction) \u2014 the monotone counters the billing pipeline consumes by subtracting two points in time. These never decrease, even when VMs are deleted.",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(\n  sum by (tenant_id, zone, direction) (lachesis_tenant_bytes_total{instance=~\"$node\",tenant_id=~\"$tenant\",zone=~\"$zone\",external_network=~\"$external_network\"})\n    * on(tenant_id) group_left(name) max by (tenant_id, name) (lachesis_tenant_info)\n)\nor\nlabel_replace(\n  sum by (tenant_id, zone, direction) (lachesis_tenant_bytes_total{instance=~\"$node\",tenant_id=~\"$tenant\",zone=~\"$zone\",external_network=~\"$external_network\"})\n    unless on(tenant_id) lachesis_tenant_info,\n  \"name\", \"\", \"\", \"\"\n)",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true
            },
            "renameByName": {
              "Value": "bytes"
            },
            "indexByName": {
              "tenant_id": 0,
              "name": 1,
              "zone": 2,
              "direction": 3,
              "Value": 4
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "bytes",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "custom": {
            "align": "auto",
            "filterable": true
          }
        }
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 5,
      "title": "Bytes/sec by zone",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Traffic rate split by destination class: external (internet), same_tenant, other_tenant, infra (DHCP/metadata/LB plumbing), shared, miss (unclassifiable), and multicast (platform-L2 chatter \u2014 counted but never billed). Each zone bills at a different rate.",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (zone) (rate(lachesis_tenant_bytes_total{instance=~\"$node\",tenant_id=~\"$tenant\",zone=~\"$zone\",external_network=~\"$external_network\"}[1m]))",
          "legendFormat": "{{zone}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": true
          },
          "unit": "binBps"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "title": "External networks",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "title": "External egress by network \u2014 tx",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Internet-bound upload split per external network \u2014 the dimension external traffic is rated on (different networks can charge differently). \"none\" collects external-zone traffic of VMs with no resolved external path. This row is pinned to zone=external; the Zone filter does not apply here.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (external_network) (rate(lachesis_tenant_bytes_total{instance=~\"$node\",tenant_id=~\"$tenant\",external_network=~\"$external_network\",zone=\"external\",direction=\"tx\"}[1m]))",
          "legendFormat": "{{external_network}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": true
          },
          "unit": "binBps"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "title": "External ingress by network \u2014 rx",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Internet-originated download split per external network \u2014 the ingress-rate counterpart of the egress panel. Pinned to zone=external like the egress panel; the Zone filter does not apply here.",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (external_network) (rate(lachesis_tenant_bytes_total{instance=~\"$node\",tenant_id=~\"$tenant\",external_network=~\"$external_network\",zone=\"external\",direction=\"rx\"}[1m]))",
          "legendFormat": "{{external_network}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": true
          },
          "unit": "binBps"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 9,
      "title": "Per-server drill-down (mortal family \u2014 rate views only)",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 10,
      "title": "Top servers by 5m throughput",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Busiest servers right now, by 5-minute average rate, with their owning tenant. Rate views only: a deleted server's series ends, so cumulative sums over this table would silently shrink \u2014 use the billable view above for totals.",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(\n  topk(15, sum by (server_id, tenant_id) (rate(lachesis_server_bytes_total{instance=~\"$node\",server_id=~\"$server\",tenant_id=~\"$tenant\",zone=~\"$zone\",external_network=~\"$external_network\"}[5m])))\n    * on(server_id) group_left(name) max by (server_id, name) (lachesis_server_info)\n)\nor\nlabel_replace(\n  topk(15, sum by (server_id, tenant_id) (rate(lachesis_server_bytes_total{instance=~\"$node\",server_id=~\"$server\",tenant_id=~\"$tenant\",zone=~\"$zone\",external_network=~\"$external_network\"}[5m])))\n    unless on(server_id) lachesis_server_info,\n  \"name\", \"\", \"\", \"\"\n)",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true
            },
            "renameByName": {
              "Value": "Bps"
            },
            "indexByName": {
              "server_id": 0,
              "name": 1,
              "tenant_id": 2,
              "Value": 3
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Bps",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "binBps",
          "custom": {
            "align": "auto",
            "filterable": true
          }
        }
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 11,
      "title": "Per-server bytes/sec (filtered by $server)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Per-server traffic rate for the servers selected in the Server filter \u2014 the drill-down after the top-talkers table points somewhere interesting. Note the Server dropdown only lists servers with series in the picked time range \u2014 a deleted server ages out of the list as its mortal series ends; widen the range to find it.",
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server_id, direction) (rate(lachesis_server_bytes_total{instance=~\"$node\",server_id=~\"$server\",tenant_id=~\"$tenant\",zone=~\"$zone\",external_network=~\"$external_network\"}[1m])) * on(server_id) group_left(name) max by (server_id, name) (lachesis_server_info)",
          "legendFormat": "{{name}} ({{server_id}}) {{direction}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (server_id, direction) (rate(lachesis_server_bytes_total{instance=~\"$node\",server_id=~\"$server\",tenant_id=~\"$tenant\",zone=~\"$zone\",external_network=~\"$external_network\"}[1m])) unless on(server_id) lachesis_server_info",
          "legendFormat": "{{server_id}} {{direction}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": true
          },
          "unit": "binBps"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    }
  ]
}
